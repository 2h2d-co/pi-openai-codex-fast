{
  "name": "pi-openai-codex-fast",
  "version": "0.0.28",
  "description": "Pi package that adds openai-codex-fast and openai-codex-ultrafast providers backed by openai-codex with the priority and ultrafast service tiers",
  "keywords": [
    "pi-package"
  ],
  "homepage": "https://github.com/2h2d-co/pi-openai-codex-fast#readme",
  "bugs": {
    "url": "https://github.com/2h2d-co/pi-openai-codex-fast/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Kaan Ozdokmeci",
    "email": "kaan@2h2d.co",
    "url": "https://www.2h2d.co"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/2h2d-co/pi-openai-codex-fast.git"
  },
  "files": [
    "index.ts",
    "model-catalog.ts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "test": "npm run test:ts && npm run test:js",
    "test:ts": "env -u PI_PACKAGE_DIR node --test --test-concurrency=1 test/*.test.ts",
    "test:js": "node scripts/test-js.ts",
    "test:live": "node scripts/test-live.ts",
    "release": "node scripts/release.ts",
    "fmt": "oxfmt",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "benchmark": "node ./benchmarks/run.ts"
  },
  "devDependencies": {
    "@2h2d/oxlint-config": "0.1.3",
    "@2h2d/ts-config": "0.0.1",
    "@earendil-works/pi-ai": "1.6.1",
    "@earendil-works/pi-coding-agent": "1.6.1",
    "@types/node": "22.20.5",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2007",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=1.6.1 <1.7.0",
    "@earendil-works/pi-coding-agent": ">=1.6.1 <1.7.0"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  }
}
