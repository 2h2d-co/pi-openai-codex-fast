{
  "name": "pi-openai-codex-fast",
  "version": "0.0.12-alpha.0",
  "description": "Pi package that adds an openai-codex-fast provider backed by openai-codex with priority service tier",
  "keywords": [
    "pi-package"
  ],
  "homepage": "https://github.com/2h2d-co/pi-openai-codex-fast#readme",
  "bugs": {
    "url": "https://github.com/2h2d-co/pi-openai-codex-fast/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Kaan Ozdokmeci",
    "email": "kaan@2h2d.co",
    "url": "https://www.2h2d.co"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/2h2d-co/pi-openai-codex-fast.git"
  },
  "files": [
    "index.ts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "check": "hk check --all --check",
    "test": "npm run test:ts && npm run test:js",
    "test:ts": "node --test --test-concurrency=1 test/*.test.ts",
    "test:js": "npm run build && TEST_EXTENSION_PATH=dist/index.js node --test --test-concurrency=1 test/*.test.ts",
    "release": "node scripts/release.ts",
    "fmt": "oxfmt",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "benchmark": "node ./benchmarks/run.ts"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.84.1",
    "@earendil-works/pi-coding-agent": "0.84.1",
    "@types/node": "26.2.0",
    "oxfmt": "0.62.0",
    "oxlint": "1.77.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.84.0 <0.85.0",
    "@earendil-works/pi-coding-agent": ">=0.84.0 <0.85.0"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  }
}
